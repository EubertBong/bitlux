# Copy to backend/.env and adjust. Real environment variables override this file.
#
# Local development (docker-compose.yml maps container 5432 -> host 5433,
# because a system PostgreSQL commonly already owns 5432):
DATABASE_URL=postgresql+asyncpg://bitlux:bitlux@localhost:5433/bitlux_crm

# Production (Neon). Note: asyncpg does not accept libpq's ?sslmode= parameter --
# env.py strips it, but prefer to omit it and configure TLS via connect_args.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/bitlux_crm
#
# The runtime MUST connect as a non-owner role so RLS applies. Migrations run as
# the owner. See DATA_MODEL.md 1.7.

# The role the application (and the test-suite) connects as. NOSUPERUSER
# NOBYPASSRLS, so Row-Level Security is actually enforced. See DATA_MODEL.md 1.7.
APP_DATABASE_URL=postgresql+asyncpg://bitlux_app:bitlux_app@localhost:5433/bitlux_crm

# --- API (Sprint 3). Read by app/config.py with the APP_ prefix. --------------
# Any APP_ENV other than local/test makes the dev-default secrets a startup error.
APP_ENV=local
APP_LOG_LEVEL=INFO
# HS256 keys. Generate real ones with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=change-me-access
APP_JWT_REFRESH_SECRET=change-me-refresh
# Fernet key material for the [enc] columns (derived via sha256; any string works locally).
APP_FIELD_ENCRYPTION_KEY=change-me-fields
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# APP_GRAPH_MAX_NODES=200   APP_SEARCH_DEFAULT_LIMIT=5   APP_SEARCH_MAX_LIMIT=25
