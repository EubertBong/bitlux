# Copy to backend/.env and adjust. Real environment variables override this file.
#
# Local development (docker-compose.yml maps container 5432 -> host 5433,
# because a system PostgreSQL commonly already owns 5432):
DATABASE_URL=postgresql+asyncpg://bitlux:bitlux@localhost:5433/bitlux_crm

# Production (Neon). Note: asyncpg does not accept libpq's ?sslmode= parameter --
# env.py strips it, but prefer to omit it and configure TLS via connect_args.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/bitlux_crm
#
# The runtime MUST connect as a non-owner role so RLS applies. Migrations run as
# the owner. See DATA_MODEL.md 1.7.
